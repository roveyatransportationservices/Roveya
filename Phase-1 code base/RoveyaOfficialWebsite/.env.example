# Copy to .env.local. The ROVEYA platform that serves /api/v1 (the main roveya website).
NEXT_PUBLIC_API_URL=http://localhost:3000
# This site's own public address, used for links and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3005
# Store links. Leave empty until the apps are published; the APK link works for Android testers.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_CAPTAIN_PLAY_STORE_URL=
NEXT_PUBLIC_APK_URL=
NEXT_PUBLIC_CAPTAIN_APK_URL=
