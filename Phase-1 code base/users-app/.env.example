# Copy to .env.local (never committed). Leave EXPO_PUBLIC_API_URL empty to run on preview data.
# The ROVEYA website that serves /api/v1, e.g. https://roveya.in or http://192.168.1.20:3000 for a phone on your Wi-Fi.
EXPO_PUBLIC_API_URL=
# Same Supabase project as the website; used only for realtime seat updates.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
