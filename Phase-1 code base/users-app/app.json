{
  "expo": {
    "name": "ROVEYA",
    "slug": "roveya-users",
    "scheme": "roveya-users",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12060D",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#12060D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.roveya.users"
    },
    "android": {
      "package": "com.roveya.users",
      "adaptiveIcon": {
        "backgroundColor": "#12060D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "ROVEYA",
      "backgroundColor": "#12060D",
      "themeColor": "#12060D"
    },
    "plugins": [
      ["expo-location", { "locationWhenInUsePermission": "ROVEYA sends your exact location to the safety desk and your emergency contacts when you press SOS." }],
      ["expo-notifications", { "color": "#D6A000" }],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "owner": "shaikasifnawaz"
  }
}
