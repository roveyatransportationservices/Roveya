# Copy to .env.local. Same Supabase project as the ROVEYA website and apps.
NEXT_PUBLIC_SUPABASE_URL=
# Server only. The secret (service role) key from Project Settings > API keys. Never expose it to a browser.
SUPABASE_SECRET_KEY=
# The public ROVEYA website. The in-car QR stickers point travellers to its /feedback page.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3005
# The ROVEYA platform website, used for links to public tracking pages.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
# Optional: Exotel, the same account as the website, so the team can call through the ROVEYA line
# with numbers kept private. Without these, calls go from the team member's own phone and are logged.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com
