# Copy to .env.local. Same Supabase project as the ROVEYA website and apps.
NEXT_PUBLIC_SUPABASE_URL=
# Server only. The secret (service role) key from Project Settings > API keys. Never expose it to a browser.
SUPABASE_SECRET_KEY=
# Real sign-in email. Verify this sender in Resend before codes will arrive.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# 2Factor OTP route. SMS_PROVIDER must be 2factor. Sender ID and template must be DLT-approved.
SMS_PROVIDER=2factor
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
# Razorpay. A car seat is confirmed only after this online payment. Key secret stays on the server.
# Webhook secret is from the Razorpay dashboard webhook, not the API key secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Expo push reads platform_settings key expo_access_token on the server. It does not read EXPO_ACCESS_TOKEN.
# Do not put the Expo token in a NEXT_PUBLIC or EXPO_PUBLIC variable.
# The public ROVEYA website. The in-car QR stickers point travellers to its /feedback page.
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3005
# The ROVEYA platform website, used for links to public tracking pages.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
# Optional: Exotel, the same account as the website, so the team can call through the ROVEYA line
# with numbers kept private. Without these, calls go from the team member's own phone and are logged.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com
